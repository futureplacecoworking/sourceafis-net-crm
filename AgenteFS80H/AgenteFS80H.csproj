<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>Assets/Reader.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Futureplace.AgenteFS80H.Desktop</RootNamespace>
    <AssemblyName>AgenteFS80H</AssemblyName>
    <Version>1.4.0</Version>
    <Company>Future Place Coworking</Company>
    <Product>Central Biométrica</Product>
    <Description>Central Biométrica — leitor da recepção Future Place.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AgenteFS80H.Core/AgenteFS80H.Core.csproj" />
    <!-- Tela do cliente (opção A) mostrada pelo Microsoft Edge WebView2 Runtime já instalado no Windows. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <InternalsVisibleTo Include="AgenteFS80H.Desktop.Tests" />
    <EmbeddedResource Include="Assets/*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Página local da tela do cliente: copiada junto do programa, sem nada baixado da internet. -->
    <None Remove="ClientPage/**" />
    <Content Include="ClientPage/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/Nunito.ttf;Assets/Nunito-Regular.ttf;Assets/Raleway.ttf;Assets/Raleway-Bold.ttf;Assets/Central.png" Link="ClientPage/assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
